{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "school-announcement",
 "main": "worker/index.ts",
 "compatibility_date": "2026-05-15",
 "workers_dev": true,
 "preview_urls": false,
 "assets": {
  "directory": "./dist",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": ["/api/*"]
 },
 "observability": {"enabled": true},
 // ชั่วคราว: นำแม่แบบชุดแรกขึ้น Drive (ลบออกหลังทำเสร็จ)
 "triggers": {"crons": ["*/2 * * * *"]},
 // โฟลเดอร์ "แม่แบบข่าว (PR Studio)" ใน Google Drive (บัญชีเดียวกับระบบโรงเรียน)
 // Secrets ตั้งใน Cloudflare: GOOGLE_DRIVE_CLIENT_ID, GOOGLE_DRIVE_CLIENT_SECRET, GOOGLE_DRIVE_REFRESH_TOKEN
 "vars": {"TEMPLATE_DRIVE_FOLDER_ID": "1JRlKu-QXmZn0a_QvFKsKalzOU47aQXu0"},
 "routes": [{"pattern": "school-announcement.banpadengschool.ac.th", "custom_domain": true}]
}
